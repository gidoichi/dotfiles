{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "ask"
    }
  },
  "provider": {
    "openai-auth": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        // run server by `npx openai-oauth@latest` before using this provider
        // see: https://github.com/EvanZhouDev/openai-oauth/
        "baseURL": "http://127.0.0.1:10531/v1"
      },
      "models": {
        "gpt-6-luna": {
          "name": "GPT-6 Luna"
        },
        "gpt-5.6-terra": {
          "name": "GPT-5.6 Terra"
        },
        "gpt-5.6-luna": {
          "name": "GPT-5.6 Luna"
        },
        "gpt-image-2": {
          "name": "GPT-Image-2"
        }
      }
    }
  },
  "enabled_providers": ["openai-auth"]
}
