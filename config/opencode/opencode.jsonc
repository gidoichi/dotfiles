{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "ask"
    }
  },
  "provider": {
    "openai-auth": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:10531/v1"
      },
      "models": {
        "gpt-6-luna": {
          "name": "GPT-6 Luna"
        },
        "gpt-5.6-terra": {
          "name": "GPT-5.6 Terra"
        },
        "gpt-5.6-luna": {
          "name": "GPT-5.6 Luna"
        },
        "gpt-image-2": {
          "name": "GPT-Image-2"
        }
      }
    }
  },
  "mcp": {
    "servers": {
      // Not an MCP server; required to start the local server for the openai-auth provider.
      "start-openai-oauth-server": {
        "enabled": true,
        "type": "local",
        "command": ["{env:HOME}/.config/opencode/bin/start-openai-oauth-server.mjs"]
      }
    }
  },
  "enabled_providers": ["openai-auth"]
}
