{
  "$schema": "https://opencode.ai/config.json",
  "websearch": {
    "provider": "random",
  },
  "permission": {
    "bash": {
      "*": "ask"
    },
    "websearch": {
      "*": "allow"
    }
  },
  "plugin": [
    "opencode-models-discovery@latest"
  ],
  "provider": {
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:4000/v1",
        "modelsDiscovery": {
          "enabled": true
        }
      }
    }
  },
  "enabled_providers": ["litellm"]
}
